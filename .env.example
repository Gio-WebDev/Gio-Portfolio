# Server-only. Copy to .env.local for local development. Never prefix secrets with VITE_.
RESEND_API_KEY=
# A plain email address on your verified sending domain/subdomain (no display name).
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=lopezjgm999@gmail.com

# Recommended for public deployment: persistent 5-request / 10-minute IP rate limit.
# Configure both together. Without these, the fallback is limited to one server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. If omitted, browser requests must match the request host (also works on previews).
CONTACT_ALLOWED_ORIGIN=
